# ============================================================
# FleetGate Environment Variables
# Copy this file to .env and fill in your real values
# ============================================================

# MongoDB Atlas connection string (required)
# Get this from: https://cloud.mongodb.com → Clusters → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=FleetGate

# Database name (optional, defaults to "fleetgate")
DB_NAME=fleetgate

# Admin credentials (optional, defaults shown)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASS=Admin@123

# Port (Render/Railway sets this automatically, leave blank locally to use 5173)
# PORT=5173
