# 1. Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase Anonymous (Public) Key
# IMPORTANT: Use the ANON key only. NEVER expose your SERVICE_ROLE key here!
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Note: You can also configure or change these credentials directly inside 
# the running app via the Settings Modal (Gear icon in top navigation).
